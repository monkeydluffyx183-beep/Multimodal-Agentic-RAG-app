"""
RAG Router
POST /rag/ingest        — add documents to a collection
POST /rag/query         — query with retrieval + generation
GET  /rag/collections   — list collections and doc counts
DELETE /rag/collections/{name} — drop a collection
"""

from fastapi import APIRouter, HTTPException
from app.models.schemas import (
    IngestRequest, IngestResponse,
    RAGQueryRequest, RAGQueryResponse,
)
from app.services import rag_service

router = APIRouter()


@router.post("/ingest", response_model=IngestResponse)
async def ingest(req: IngestRequest):
    n = await rag_service.ingest(req.texts, req.metadata, req.collection)
    return IngestResponse(collection=req.collection, chunks_added=n)


@router.post("/query", response_model=RAGQueryResponse)
async def query(req: RAGQueryRequest):
    model = req.config.model or (
        "claude-sonnet-4-20250514" if req.config.provider == "claude" else "llama3.1:8b"
    )
    answer, sources = await rag_service.rag_query(
        query=req.query,
        collection=req.collection,
        top_k=req.top_k,
        mode=req.mode,
        cfg=req.config,
    )
    return RAGQueryResponse(
        provider=req.config.provider,
        model=model,
        answer=answer,
        sources=sources,
        mode=req.mode,
        usage=None,
    )


@router.get("/collections")
async def list_collections():
    return {
        "collections": {
            name: len(docs)
            for name, docs in rag_service._store.items()
        }
    }


@router.delete("/collections/{name}")
async def delete_collection(name: str):
    if name not in rag_service._store:
        raise HTTPException(status_code=404, detail=f"Collection '{name}' not found")
    del rag_service._store[name]
    return {"deleted": name}
